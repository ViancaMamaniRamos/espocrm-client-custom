{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "status": {
            "type": "enum",
            "options": [
                "",
                "Identificado",
                "Investigando",
                "Resuelto"
            ],
            "style": {
                "": null,
                "Identificado": null,
                "Investigando": null,
                "Resuelto": null
            },
            "maxLength": 100,
            "isCustom": true
        },
        "detectedBy": {
            "type": "enum",
            "options": [
                "",
                "cortex",
                "firewall",
                "mail"
            ],
            "style": {
                "": null,
                "cortex": null,
                "firewall": null,
                "mail": null
            },
            "maxLength": 100,
            "isCustom": true
        },
        "bySystem": {
            "notNull": true,
            "type": "bool",
            "isCustom": true
        },
        "urgent": {
            "notNull": true,
            "type": "bool",
            "isCustom": true
        },
        "actionsTaken": {
            "type": "multiEnum",
            "storeArrayValues": true,
            "default": [],
            "style": {
                "Desconexión de equipo": null,
                "Sospecha de falso positivo": null,
                "Reinicio de Equipo": null,
                "Atacante agregado a IoC": null,
                "Falso Positivo": null
            },
            "isCustom": true,
            "options": [
                "Desconexión de equipo",
                "Sospecha de falso positivo",
                "Reinicio de Equipo",
                "Atacante agregado a IoC",
                "Falso Positivo"
            ],
            "allowCustomOptions": true
        },
        "account": {
            "type": "link"
        },
        "cortexUserName": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "md5": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "fileName": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "threat": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "firewallSource": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "firewallDestination": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "domain": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "mailSource": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "mailDestination": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "createCase": {
            "notNull": true,
            "type": "bool",
            "isCustom": true
        },
        "contacts": {
            "type": "linkMultiple"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "meetings": {
            "type": "hasMany",
            "entity": "Meeting",
            "foreign": "parent"
        },
        "calls": {
            "type": "hasMany",
            "entity": "Call",
            "foreign": "parent"
        },
        "tasks": {
            "type": "hasChildren",
            "entity": "Task",
            "foreign": "parent"
        },
        "emails": {
            "type": "hasChildren",
            "entity": "Email",
            "foreign": "parent",
            "layoutRelationshipsDisabled": true
        },
        "account": {
            "type": "belongsTo",
            "foreign": "cIncidents",
            "entity": "Account",
            "audited": false,
            "isCustom": true
        },
        "contacts": {
            "type": "hasMany",
            "relationName": "cIncidentContact",
            "foreign": "cIncidents",
            "entity": "Contact",
            "audited": false,
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc",
        "textFilterFields": [
            "name"
        ],
        "fullTextSearch": false,
        "countDisabled": false
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    },
    "optimisticConcurrencyControl": false
}