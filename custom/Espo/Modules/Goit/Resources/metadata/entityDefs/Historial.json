{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "maxLength": 255,
            "pattern": "$noBadCharacters"
        },
        "requestType": {
            "type": "varchar",
            "maxLength": 20
        },
        "targetEntityType": {
            "type": "varchar",
            "maxLength": 100
        },
        "targetRecordId": {
            "type": "varchar",
            "maxLength": 36
        },
        "targetField": {
            "type": "varchar",
            "maxLength": 100
        },
        "modValue": {
            "type": "text"
        },
        "payload": {
            "type": "jsonObject"
        },
        "success": {
            "type": "bool"
        },
        "message": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        },
        "targetRecordId": {
            "columns": [
                "targetRecordId",
                "deleted"
            ]
        }
    }
}
